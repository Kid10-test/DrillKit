+<!doctype html>
+<html lang="id">
+<head>
+<meta charset="utf-8">
+<title>Contoh kartu lipat buku saku — DrillKit</title>
+<style>
+  /* ============ Layar (petunjuk) ============ */
+  body {
+    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+    background: #0f172a; color: #e2e8f0; margin: 0; padding: 24px;
+  }
+  .petunjuk { max-width: 920px; margin: 0 auto 24px; }
+  .petunjuk h1 { font-size: 20px; margin: 0 0 8px; }
+  .petunjuk p, .petunjuk li { font-size: 14px; line-height: 1.6; color: #cbd5e1; }
+  .petunjuk ol { padding-left: 22px; margin: 8px 0; }
+  .petunjuk .tombol {
+    display: inline-block; margin-top: 12px; padding: 10px 22px;
+    background: #0284c7; color: #fff; border: 0; border-radius: 8px;
+    font-size: 15px; cursor: pointer;
+  }
+  @media print {
+    .no-print { display: none !important; }
+    body { background: #fff; padding: 0; }
+  }
+
+  /* ============ Kertas ============ */
+  @page { size: A4 portrait; margin: 8mm; }
+  .lembar { width: 194mm; margin: 0 auto; background: #fff; color: #000; }
+  @media screen {
+    .lembar { padding: 8mm; box-shadow: 0 0 24px rgba(0,0,0,.5); }
+  }
+  /**
+   * Satu kartu = lembaran 190 × 135 mm, dicetak satu sisi.
+   * Garis tepi penuh = garis potong, garis tengah putus-putus = garis lipat
+   * (panel kanan dilipat ke belakang, jadi kedua muka tercetak menghadap luar).
+   */
+  .kartu {
+    width: 190mm; height: 135mm; margin: 0 2mm;
+    border: .5mm solid #111; box-sizing: border-box;
+    display: flex; position: relative; background: #fff;
+    page-break-inside: avoid;
+  }
+  .muka { flex: 1 1 0; min-width: 0; box-sizing: border-box; padding: 3.5mm 4mm; overflow: hidden; }
+  .muka.depan { border-right: .4mm dashed #555; }
+  .antar {
+    height: 6mm; margin: 0 2mm; display: flex; align-items: center; gap: 2mm;
+    color: #888; font-size: 8px; white-space: nowrap;
+  }
+  .antar .garis { flex: 1; border-top: .3mm dashed #999; }
+  .gunting { position: absolute; color: #666; font-size: 9px; line-height: 1; }
+  .gunting.tl { top: .5mm; left: 1mm; }
+  .gunting.tr { top: .5mm; right: 1mm; }
+  .gunting.bl { bottom: .5mm; left: 1mm; }
+  .gunting.br { bottom: .5mm; right: 1mm; }
+  .lipat {
+    position: absolute; left: 50%; transform: translateX(-50%);
+    background: #fff; padding: 0 2mm;
+    font-size: 6px; letter-spacing: .12em; color: #555; white-space: nowrap;
