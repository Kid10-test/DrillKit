-  const snapVal = (x: number, y: number) => {
-    if (!snapRef.current) return { x, y }
-    // DD1 — kalau tim memakai patok, titik menempel ke patok terdekat,
-    // bukan ke langkah terdekat: pemain berdiri di patok, bukan di antaranya.
