+        [true, 6], // #
+        [true, 16], // Set (satu-satunya kolom yang boleh terelipsis)
+        [true, 7], // Cnt
+        [true, 38], // Koordinat (±27 karakter mono — tak boleh terpotong)
+        [true, 12], // Langkah & arah
+        [sertakanLpc, 9], // Lk/cnt
+        [sertakanUkuran, 12], // Ukuran langkah
