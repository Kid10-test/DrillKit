+              : labelDepan
+        const isiBelakang =
+          b1 > b0
+            ? `<p class="sambung">← sambungan Set ${b0 + 1}–${b1} · ${esc(m.name)} <span class="code">${esc(m.code)}</span></p>
+               <table>${kolomLipat()}${kepalaTabel(true)}<tbody>${rowsFor(m, true, lpc, b0, b1)}</tbody></table>`
