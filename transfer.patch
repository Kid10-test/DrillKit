+<body>
+  <div class="petunjuk no-print">
+    <h1>Contoh cetak: kartu lipat buku saku</h1>
+    <p>
+      Ini <b>contoh di luar aplikasi</b> (data khayalan: show 51 set, 2 pemain).
+      Satu lembar A4 memuat <b>dua kartu</b>; satu kartu = lembaran 190 × 135 mm
+      yang dilipat dua menjadi kartu 9,5 × 13,5 cm bermuka dua. Muka depan memuat
+      kepala kartu + kompas + set awal; muka belakang memuat sambungan set +
+      keterangan + catatan.
+    </p>
+    <ol>
+      <li>Tekan <b>Cetak contoh</b> → kertas <b>A4</b> → skala <b>100%</b> →
+        matikan header/footer browser → cetak.</li>
+      <li><b>Potong</b> mengikuti garis tepi penuh (✂).</li>
+      <li><b>Lipat</b> garis putus-putus ke belakang: panel kanan menjadi muka
+        belakang kartu.</li>
+    </ol>
+    <p>Kalau tata letak ini disetujui, beginilah yang akan dipasang ke tombol
+      “Buku saku” di aplikasi.</p>
+    <button class="tombol" onclick="window.print()">Cetak contoh</button>
+  </div>
+
+  <div class="lembar" id="lembar"></div>
+
+<script>
+  // ---------- Data khayalan (deterministik, bukan acak) ----------
+  const DRILL = { nama: 'Demo — Parade Senja', tempo: 120, ketuk: 1 };
+  const PEMAIN = [
+    { nama: 'Citra Dewi', kode: 'BR03', seksi: 'Brass · Trombone' },
+    { nama: 'Putri Ramadhani', kode: 'GU15', seksi: 'Guard · Flag' },
+  ];
+  const NAMA_SET = ['Blok', 'Busur', 'Diagonal', 'Ombak', 'Bintang', 'Koridor', 'Kipas', 'Tangga', 'Lingkaran', 'Garis'];
+  const POLA_COUNT = [16, 16, 16, 12, 16, 8, 16, 12];
+  const HURUF = ['A', 'A#', 'B', 'B#', 'C', "C'", "B'", "A'"];
+  const PANAH = ['→', '↘', '↓', '↙', '←', '↖', '↑', '↗'];
+  const OFF_H = [0, 2.25, -1.5, 0.75, 0, -2, 1.25, 3];
+  const OFF_T = [1, 0, -0.5, 2, 0, 1.5, 0, -1.25];
+  // Gerakan besar yang disengaja (indeks set → langkah), supaya ada warna contoh.
+  const BESAR = [{ 5: 26, 11: 24, 17: 22, 23: 28, 28: 20 }, { 4: 27, 12: 23, 19: 25, 25: 21, 30: 26 }];
+  const N_SET = 51;
+  const MUAT_DEPAN = 27; // kapasitas baris muka depan (baris satu-baris berelipsis)
+
+  function fmtOff(v) {
+    const r = Math.round(v * 4) / 4;
+    if (r === 0) return '';
+    return (r > 0 ? '+' : '') + r;
+  }
+  function koordinat(i, p) {
+    const h = HURUF[(i + p * 3) % HURUF.length];
+    const t = ((i * 3 + p) % 8) + 1;
+    const oh = OFF_H[(i + p * 2) % 8];
+    const ot = OFF_T[(i * 2 + p) % 8];
+    if (oh === 0 && ot === 0) return h + t;
+    const hs = oh === 0 ? h : h + ' ' + fmtOff(oh);
+    const ts = ot === 0 ? 'T' + t : 'T' + t + ' ' + fmtOff(ot);
+    return hs + ' · ' + ts;
+  }
+  function setKe(i) {
+    const nama = 'Set ' + (i + 1) + ' — ' + NAMA_SET[i % NAMA_SET.length];
+    const counts = i === N_SET - 1 ? 0 : POLA_COUNT[i % POLA_COUNT.length];
+    return { nama, counts };
+  }
+  function gerak(i, p, counts) {
+    if (i === N_SET - 1) return { langkah: '-', panah: '', lpc: '-', ukuran: '-' };
+    const langkah = BESAR[p][i] !== undefined ? BESAR[p][i] : 4 + ((i * 5 + p * 3) % 13);
+    const panah = PANAH[(i * 3 + p * 5) % PANAH.length];
+    const lpc = Math.round((langkah / counts) * 100) / 100;
+    const selLpc = lpc > 1.5
+      ? '<span style="color:#ef4444;font-weight:700">' + lpc + '</span>'
+      : lpc > 1.25
+        ? '<span style="color:#fb923c;font-weight:700">' + lpc + '</span>'
+        : '<span class="mono">' + lpc + '</span>';
+    return {
+      langkah: langkah + ' <span class="panah">' + panah + '</span>',
+      lpc: selLpc,
+      ukuran: '<span class="mono">22.5&Prime;</span>',
+    };
+  }
+  function baris(i, p) {
+    const s = setKe(i);
+    const g = gerak(i, p, s.counts);
+    const td = (x) => x === '-' ? '<td><span class="muted">-</span></td>' : '<td>' + x + '</td>';
+    return '<tr><td>' + (i + 1) + '</td><td>' + s.nama + '</td><td>' + s.counts +
+      '</td><td class="mono">' + koordinat(i, p) + '</td>' + td(g.langkah) + td(g.lpc) + td(g.ukuran) + '</tr>';
+  }
+  const KOLOM = '<colgroup><col style="width:6%"><col style="width:16%"><col style="width:7%">' +
+    '<col style="width:38%"><col style="width:12%"><col style="width:9%"><col style="width:12%"></colgroup>';
+  const KEPALA_TABEL = '<thead><tr><th>#</th><th>Set</th><th>Cnt</th><th>Koordinat</th>' +
+    '<th>Langkah <br>&amp; arah</th><th>Lk/<br>cnt</th><th>Ukuran <br>langkah</th></tr></thead>';
+
+  const KOMPAS = '<div class="kompas">' +
+    '<svg viewBox="0 0 40 40" width="34" height="34" style="flex:none">' +
+    '<rect x="1" y="1" width="38" height="38" fill="none" stroke="#94a3b8"/>' +
+    '<text x="20" y="9" font-size="6" text-anchor="middle" fill="#64748b">BELAKANG</text>' +
+    '<text x="20" y="36" font-size="6" text-anchor="middle" fill="#64748b">PENONTON</text>' +
+    '<text x="3" y="23" font-size="6" fill="#64748b">S1</text>' +
+    '<text x="30" y="23" font-size="6" fill="#64748b">S2</text>' +
+    '<path d="M20 30 L20 14" stroke="#334155" stroke-width="1.2"/>' +
+    '<path d="M20 14 l-3 4 M20 14 l3 4" stroke="#334155" stroke-width="1.2" fill="none"/>' +
+    '</svg>' +
+    '<div><b>A</b> = tengah lapangan &middot; <b>&minus;</b> mendekati A &middot; <b>+</b> menjauhi A<br>' +
+    '<span class="mono">C&#39;</span> = C di seberang A (sisi S2) &middot; panah = arah jalan</div></div>';
+
+  function kartu(p) {
+    const m = PEMAIN[p];
+    let depan = '';
+    for (let i = 0; i < MUAT_DEPAN; i++) depan += baris(i, p);
+    let belakang = '';
+    for (let i = MUAT_DEPAN; i < N_SET; i++) belakang += baris(i, p);
+    const tgl = new Date().toLocaleDateString('id-ID');
+    return '<div class="kartu">' +
+      '<span class="gunting tl">✂</span><span class="gunting tr">✂</span>' +
+      '<span class="gunting bl">✂</span><span class="gunting br">✂</span>' +
+      '<span class="lipat atas">— LIPAT —</span><span class="lipat bawah">— LIPAT —</span>' +
+      '<div class="muka depan">' +
+        '<header><div><h2>' + m.nama + ' <span class="code">' + m.kode + '</span></h2>' +
+        '<p class="sub">' + m.seksi + '</p></div>' +
+        '<div class="right"><p class="sub">' + DRILL.nama + '</p>' +
+        '<p class="sub">' + DRILL.tempo + ' BPM · ' + DRILL.ketuk + ' ketuk/count</p></div></header>' +
+        KOMPAS +
+        '<table>' + KOLOM + KEPALA_TABEL + '<tbody>' + depan + '</tbody></table>' +
+        '<p class="kaki">Set 1–' + MUAT_DEPAN + ' · bersambung ke muka belakang →</p>' +
+      '</div>' +
+      '<div class="muka">' +
+        '<p class="sambung">← sambungan Set ' + (MUAT_DEPAN + 1) + '–' + N_SET + ' · ' + m.nama + ' <span class="code">' + m.kode + '</span></p>' +
+        '<table>' + KOLOM + KEPALA_TABEL + '<tbody>' + belakang + '</tbody></table>' +
+        '<p class="legend">Lk/cnt = langkah per hitungan pada ' + DRILL.tempo + ' BPM, ' + DRILL.ketuk + ' ketuk/count — jawabannya <i>apakah aku harus berlari</i>. Angka berwarna: <span style="color:#fb923c;font-weight:700">berat</span> atau <span style="color:#ef4444;font-weight:700">mustahil</span> diselesaikan.</p>' +
+        '<p class="legend"><b>Ukuran langkah</b> = panjang satu langkah yang harus dipakai, dalam inci — jawabannya <i>mampukah kakiku melangkah sejauh itu</i>. Bawaan 22,5&Prime; (8-to-5). Di atas 30&Prime; (6-to-5) mulai berat, di atas 45&Prime; (4-to-5) praktis mustahil.</p>' +
+        '<p class="notes">Titik acuan: patok A dan T1. Wajib bawa metronom.</p>' +
+        '<p class="kaki">muka belakang · kartu 1/1 · ' + tgl + '</p>' +
+      '</div>' +
+    '</div>';
+  }
+
+  document.getElementById('lembar').innerHTML =
+    kartu(0) + '<div class="antar"><span>✂</span><div class="garis"></div><span>potong</span><div class="garis"></div><span>✂</span></div>' + kartu(1);
+</script>
+</body>
+</html>
