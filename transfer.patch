+
+/** DD6 — Detail gerak per pemain di semua set. */
+import { useEffect, useMemo, useState } from 'react'
+import { db } from '../db/db'
+import type {
+  Drill,
+  DrillSet,
+  Member,
+  ModeLangkah,
+  SetelanLangkah,
+} from '../db/types'
+import {
+  Button,
+  Field,
